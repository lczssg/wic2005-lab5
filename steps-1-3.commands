h1 ping -c 3 h2
h1 ping -c 3 h3
sh ./p4cli s2 table_dump MyIngress.ipv4_lpm
sh ./p4cli s2 table_delete MyIngress.ipv4_lpm 2
h1 ping -c 2 -W 1 h3
sh ./p4cli s2 "table_add MyIngress.ipv4_lpm MyIngress.ipv4_forward 10.1.0.3/32 => 3"
h1 ping -c 2 h3
h1 python3 send.py 10.1.0.3 "test 1" --tunnel 2
sh sleep 1
sh cat logs/h2.txt logs/h3.txt
sh grep -n -A 12 -B 4 'key is 1212' logs/s1.txt
sh mkdir -p lab-evidence/steps-1-3
sh cp logs/s1.txt logs/s2.txt logs/h2.txt logs/h3.txt lab-evidence/steps-1-3/
exit
